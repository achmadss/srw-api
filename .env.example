# =============================================================================
# SRW API - Required Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed
#
# For Docker Compose: Use service names (postgres, minio, rabbitmq)
# For Local Development: Use localhost
# =============================================================================

API_PORT=8080
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Database (Required)
DB_URL=jdbc:postgresql://postgres:5432/srw_db
DB_USER=postgres
DB_PASSWORD=password

# JWT Configuration (Required)
JWT_ISSUER=http://0.0.0.0:8080/
ADMIN_JWT_AUDIENCE=http://0.0.0.0:8080/admin
CLIENT_JWT_AUDIENCE=http://0.0.0.0:8080/client
AGENT_JWT_AUDIENCE=http://0.0.0.0:8080/agent

# JWT Secrets (Required - CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET=change-this-admin-secret-in-production
CLIENT_JWT_SECRET=change-this-client-secret-in-production
AGENT_JWT_SECRET=change-this-agent-secret-in-production

# MinIO Object Storage (Required)
MINIO_HOSTNAME=http://minio:9000
MINIO_PUBLIC_HOSTNAME=https://example.com
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=srw-images

# RabbitMQ (Required)
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672

# Optional - Default Admin (for first-time setup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# Optional - Trash Types Configuration
TRASH_TYPES_CONFIG_PATH=trash-types.json
DEFAULT_TRASH_POINTS_PER_UNIT=10
